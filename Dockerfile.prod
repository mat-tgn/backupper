# Dockerfile per produzione
FROM node:18-alpine AS builder

WORKDIR /app

# --- Client: dipendenze + build ---
COPY client/package.json ./client/
COPY client/package-lock.json* ./client/
RUN cd client && \
  if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY client ./client
# Evita che warning ESLint facciano fallire la build in CI/Docker
ENV CI=false
RUN cd client && npm run build

# --- Server: solo dipendenze di produzione ---
COPY server/package.json ./server/
RUN cd server && npm install --omit=dev

COPY server ./server

# Immagine di produzione (senza sorgenti client né tool di build)
FROM node:18-alpine AS production

RUN apk add --no-cache mysql-client

RUN addgroup -g 1001 -S nodejs \
  && adduser -S backupper -u 1001

WORKDIR /app

COPY --from=builder --chown=backupper:nodejs /app/server ./server
COPY --from=builder --chown=backupper:nodejs /app/client/build ./client/build

RUN mkdir -p /app/server/backups /app/server/data \
  && chown -R backupper:nodejs /app/server/backups /app/server/data

USER backupper

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

CMD ["node", "server/index.js"]
