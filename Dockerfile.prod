# Dockerfile per produzione
FROM node:18-alpine AS builder

WORKDIR /app

# --- Frontend: dipendenze + build ---
COPY frontend/package.json ./frontend/
COPY frontend/package-lock.json* ./frontend/
# npm install: il lockfile può non essere allineato con npm 10 (Node 18) nel container
RUN cd frontend && npm install

COPY frontend ./frontend
# Evita che warning ESLint facciano fallire la build in CI/Docker
ENV CI=false
RUN cd frontend && npm run build

# --- Backend: solo dipendenze di produzione ---
COPY backend/package.json ./backend/
RUN cd backend && npm install --omit=dev

COPY backend ./backend

# Immagine di produzione (senza sorgenti frontend né tool di build)
FROM node:18-alpine AS production

# curl/tar: download aggiornamenti; python/make/g++: npm install in-container
RUN apk add --no-cache mysql-client curl tar python3 make g++

RUN addgroup -g 1001 -S nodejs \
  && adduser -S backupper -u 1001

WORKDIR /app

COPY --from=builder --chown=backupper:nodejs /app/backend ./backend
COPY --from=builder --chown=backupper:nodejs /app/frontend/build ./frontend/build

RUN mkdir -p /app/backend/backups /app/backend/data /app/logs /app/frontend \
  && chown -R backupper:nodejs /app

USER backupper

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

CMD ["node", "backend/index.js"]
